# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Force specific files to always have LF in the working tree
*.sh     text eol=lf
*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.svg    text eol=lf

# Files that must keep CRLF, even on Linux/macOS
*.sln     text eol=crlf
*.vcproj  text eol=crlf

# Binary files — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary

*.png filter=lfs diff=lfs merge=lfs -text
